{
  "identifier": "default",
  "description": "Permissions for the main window on every platform",
  "windows": [
    "main",
    "widget",
    "widget-*"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        }
      ]
    },
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    }
  ]
}
