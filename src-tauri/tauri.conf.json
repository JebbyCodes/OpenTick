{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTick",
  "version": "0.2.0",
  "identifier": "com.opentick.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node dev-server.mjs",
    "beforeBuildCommand": "node build-app.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "OpenTick", "width": 1180, "height": 780, "minWidth": 360, "minHeight": 520 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
