<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ot_rx_root" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="3dp">
<ImageView android:id="@+id/ot_rx_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_row" android:scaleType="fitXY" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp">
<TextView android:id="@+id/ot_rx_time" android:layout_width="46dp" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="false" android:lines="2" android:gravity="end" android:layout_marginEnd="6dp" />
<ImageView android:id="@+id/ot_rx_bar" android:layout_width="4dp" android:layout_height="40dp" android:importantForAccessibility="no" android:src="@drawable/ot_widget_bar" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
<TextView android:id="@+id/ot_rx_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
<TextView android:id="@+id/ot_rx_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" />
<TextView android:id="@+id/ot_rx_who" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
