<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:id="@+id/ot_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/ot_widget_bg" android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/ot_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="16sp" android:textStyle="bold" android:text="Today" />
            <TextView android:id="@+id/ot_count" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="8dp" android:textSize="12sp" />
            <ImageView android:id="@+id/ot_add" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ot_widget_plus" android:contentDescription="Add a task" />
        </LinearLayout>

        <TextView android:id="@+id/ot_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="16dp" android:textSize="13sp" android:visibility="gone" />

        <LinearLayout android:id="@+id/ot_r0" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c0" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ot_r1" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c1" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ot_r2" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c2" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ot_r3" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c3" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ot_r4" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c4" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ot_r5" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c5" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ot_r6" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c6" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ot_r7" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="10dp" android:visibility="gone">
            <ImageView android:id="@+id/ot_c7" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ot_widget_ring" android:contentDescription="Complete task" />
            <TextView android:id="@+id/ot_t7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textSize="14sp" />
            <TextView android:id="@+id/ot_d7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textSize="11sp" />
        </LinearLayout>

        <TextView android:id="@+id/ot_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingTop="2dp" android:textSize="11sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
