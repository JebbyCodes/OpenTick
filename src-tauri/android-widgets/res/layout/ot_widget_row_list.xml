<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ot_rl_root" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginBottom="3dp">
<ImageView android:id="@+id/ot_rl_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_row" android:scaleType="fitXY" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp">
<ImageView android:id="@+id/ot_rl_dot" android:layout_width="12dp" android:layout_height="12dp" android:importantForAccessibility="no" android:src="@drawable/ot_widget_dot" />
<TextView android:id="@+id/ot_rl_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="10dp" />
<TextView android:id="@+id/ot_rl_late" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:layout_marginEnd="8dp" />
<TextView android:id="@+id/ot_rl_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
</FrameLayout>
