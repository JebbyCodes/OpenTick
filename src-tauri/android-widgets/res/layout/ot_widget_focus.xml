<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ot_fc_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/ot_fc_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_bg" android:scaleType="fitXY" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="2dp">
<TextView android:id="@+id/ot_fc_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:text="Focus" />
<TextView android:id="@+id/ot_fc_sub" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" />
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ImageView android:id="@+id/ot_fc_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:importantForAccessibility="no" />
<Chronometer android:id="@+id/ot_fc_time" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="28sp" android:textStyle="bold" android:visibility="gone" />
<TextView android:id="@+id/ot_fc_text" android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="28sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
</FrameLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:id="@+id/ot_fc_btnf" android:layout_margin="4dp">
<ImageView android:id="@+id/ot_fc_btnbg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_row" android:scaleType="fitXY" />
<TextView android:id="@+id/ot_fc_btn" android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
</FrameLayout>
</LinearLayout>
</FrameLayout>
