<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ot_rc_root" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="3dp">
<ImageView android:id="@+id/ot_rc_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_row" android:scaleType="fitXY" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="10dp">
<FrameLayout android:layout_width="34dp" android:layout_height="34dp">
<ImageView android:id="@+id/ot_rc_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_circle" />
<TextView android:id="@+id/ot_rc_emoji" android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="15sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
</FrameLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
<TextView android:id="@+id/ot_rc_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:paddingEnd="6dp">
<TextView android:id="@+id/ot_rc_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
<TextView android:id="@+id/ot_rc_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
