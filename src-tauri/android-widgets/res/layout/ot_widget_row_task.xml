<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ot_rt_root" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="3dp">
<ImageView android:id="@+id/ot_rt_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_row" android:scaleType="fitXY" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="10dp">
<ImageView android:id="@+id/ot_rt_check" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:importantForAccessibility="yes" android:contentDescription="Complete task" android:src="@drawable/ot_widget_ring" />
<TextView android:id="@+id/ot_rt_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" />
<ImageView android:id="@+id/ot_rt_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="6dp" android:importantForAccessibility="no" android:src="@drawable/ot_widget_dot" />
<TextView android:id="@+id/ot_rt_list" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="4dp" android:maxWidth="72dp" />
<TextView android:id="@+id/ot_rt_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:layout_marginStart="8dp" />
</LinearLayout>
</FrameLayout>
