<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ot_cal_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/ot_cal_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_bg" android:scaleType="fitXY" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="2dp">
<TextView android:id="@+id/ot_cal_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" />
<TextView android:id="@+id/ot_cal_sub" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" />
<ImageView android:id="@+id/ot_cal_prev" android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:importantForAccessibility="yes" android:contentDescription="Previous month" android:src="@drawable/ot_widget_prev" />
<ImageView android:id="@+id/ot_cal_next" android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:importantForAccessibility="yes" android:contentDescription="Next month" android:src="@drawable/ot_widget_next" />
<FrameLayout android:layout_width="40dp" android:layout_height="40dp">
<ImageView android:id="@+id/ot_cal_add" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="7dp" android:importantForAccessibility="yes" android:contentDescription="New task" android:src="@drawable/ot_widget_circle" />
<ImageView android:id="@+id/ot_cal_plus" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:importantForAccessibility="no" android:src="@drawable/ot_widget_plus" />
</FrameLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/ot_cal_w0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
<TextView android:id="@+id/ot_cal_w1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
<TextView android:id="@+id/ot_cal_w2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
<TextView android:id="@+id/ot_cal_w3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
<TextView android:id="@+id/ot_cal_w4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
<TextView android:id="@+id/ot_cal_w5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
<TextView android:id="@+id/ot_cal_w6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="center" />
</LinearLayout>
<TextView android:id="@+id/ot_cal_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:singleLine="false" android:gravity="center" android:paddingTop="16dp" android:visibility="gone" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/ot_cal_list" android:orientation="vertical" />
<TextView android:id="@+id/ot_cal_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:paddingStart="14dp" android:paddingTop="2dp" android:visibility="gone" />
<TextView android:id="@+id/ot_cal_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:paddingStart="10dp" android:paddingTop="4dp" />
</LinearLayout>
</FrameLayout>
