<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ot_pr_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/ot_pr_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/ot_widget_bg" android:scaleType="fitXY" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="2dp">
<TextView android:id="@+id/ot_pr_title" android:layout_width="wrap_content" android:layout_height="match_parent" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:text="Projects" />
<TextView android:id="@+id/ot_pr_sub" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical" android:paddingStart="8dp" />
<FrameLayout android:layout_width="40dp" android:layout_height="40dp">
<ImageView android:id="@+id/ot_pr_add" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="7dp" android:importantForAccessibility="yes" android:contentDescription="New task" android:src="@drawable/ot_widget_circle" />
<ImageView android:id="@+id/ot_pr_plus" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:importantForAccessibility="no" android:src="@drawable/ot_widget_plus" />
</FrameLayout>
</LinearLayout>
<TextView android:id="@+id/ot_pr_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:singleLine="false" android:gravity="center" android:paddingTop="16dp" android:visibility="gone" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/ot_pr_list" android:orientation="vertical" />
<TextView android:id="@+id/ot_pr_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:paddingStart="14dp" android:paddingTop="2dp" android:visibility="gone" />
</LinearLayout>
</FrameLayout>
